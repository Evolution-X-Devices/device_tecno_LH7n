type hal_codec2_mtk, domain;
type hal_codec2_mtk_exec, exec_type, vendor_file_type, file_type;

hal_server_domain(hal_codec2_mtk, hal_codec2)
typeattribute hal_codec2_mtk hal_codec2_server;

init_daemon_domain(hal_codec2_mtk)

hwbinder_use(hal_codec2_mtk)
allow hal_codec2_mtk servicemanager:binder { call transfer };
allow hal_codec2_mtk audioserver_service:service_manager find;

binder_call(hal_codec2_mtk, audioserver)
binder_call(hal_codec2_mtk, mediaserver)
binder_call(audioserver, hal_codec2_mtk)
binder_call(mediaserver, hal_codec2_mtk)

allow hal_codec2_mtk dmabuf_system_heap_device:chr_file r_file_perms;
allow hal_codec2_mtk ion_device:chr_file r_file_perms;
allow hal_codec2_mtk gpu_device:chr_file rw_file_perms;

allow hal_codec2_mtk vcodec_device:chr_file rw_file_perms;
allow hal_codec2_mtk mtk_disp_device:chr_file r_file_perms;

allow hal_codec2_mtk self:process { getsched setsched };
allow hal_codec2_mtk audioserver:fifo_file rw_file_perms;

allow hal_codec2_mtk surfaceflinger:fd use;
allow hal_codec2_mtk hal_graphics_allocator_default:fd use;
allow hal_codec2_mtk hal_graphics_mapper_hwservice:hwservice_manager find;

get_prop(hal_codec2_mtk, vendor_default_prop)